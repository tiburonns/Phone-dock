<Window x:Class="PhoneDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Phone Dock" Width="1120" Height="800" MinWidth="850" MinHeight="600" Icon="Assets/BrandIcon.png">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,28,12,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26">
          <Image Source="Assets/BrandIcon.png" Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,14"/>
          <TextBlock Text="Phone Dock" FontSize="22" FontWeight="Bold"/>
          <TextBlock x:Name="StudioLabel" Foreground="{DynamicResource Secondary}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock x:Name="ConnectionStatus" Text="Preparando conexión…" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" Margin="0,0,0,14"/>
          <TextBlock x:Name="FooterLabel" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel x:Name="Navigation"/>
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="32,24,24,20">
      <Border x:Name="ErrorPanel" DockPanel.Dock="Bottom" Background="#FFF0DA" CornerRadius="12" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
        <DockPanel><Button x:Name="DismissButton" DockPanel.Dock="Right" Click="DismissError"/><TextBlock x:Name="ErrorText" Foreground="#693D19" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel x:Name="PageContent"/></ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
